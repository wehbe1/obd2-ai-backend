# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required — your OpenAI API key
OPENAI_API_KEY=sk-proj-...

# Optional — OpenAI model for dashboard analysis (default: gpt-4o)
# gpt-4o        → best accuracy, higher cost
# gpt-4o-mini   → faster, cheaper, still good for dashboards
OPENAI_MODEL=gpt-4o

# Optional — max pixels for the longest image edge before sending to OpenAI
# Smaller = faster + cheaper; larger = more detail
MAX_IMAGE_PX=1024
